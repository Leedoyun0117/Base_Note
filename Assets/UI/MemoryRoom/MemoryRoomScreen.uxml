<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="MemoryRoomScreen.uss" />

    <ui:VisualElement name="screen" class="screen">

        <ui:VisualElement name="navigation-panel" class="panel">
            <ui:Label text="기억 방" class="panel-title" />

            <ui:Label name="current-room-label" text="-" class="current-room-label" />
            <ui:Label name="current-room-restored-badge" text="복원됨" class="restored-badge" />

            <ui:Label text="정신력" class="section-label" />
            <ui:VisualElement class="mentality-bar-track">
                <ui:VisualElement name="mentality-bar-fill" class="mentality-bar-fill" />
            </ui:VisualElement>
            <ui:Label name="mentality-value" text="- / -" class="caption" />
            <ui:Label name="mentality-affordance-notice" text="" class="caption" />
            <ui:Label name="mentality-notice" text="" class="failure-message" />
            <ui:Label name="move-failure-message" text="" class="failure-message" />
        </ui:VisualElement>

        <ui:VisualElement name="memory-map-panel" class="panel">
            <ui:Label text="기억 지도" class="panel-title" />
            <ui:Label text="누르면 크게 볼 수 있습니다." class="caption" />
            <ui:VisualElement name="memory-map-preview" class="memory-map-preview" />
        </ui:VisualElement>

        <ui:VisualElement name="clue-panel" class="panel">
            <ui:Label text="단서" class="panel-title" />
            <ui:Label text="아직 줍지 않은 단서 (방 배경 오브젝트로 교체될 자리)" class="caption" />
            <ui:ScrollView name="clue-list" class="clue-list" />
            <ui:Label name="clue-collect-failure-message" text="" class="failure-message" />
        </ui:VisualElement>

        <ui:VisualElement name="inventory-panel" class="panel">
            <ui:Label text="인벤토리" class="panel-title" />
            <ui:Label name="inventory-count" text="- / -" class="caption" />
            <ui:Label
                name="inventory-full-notice"
                text="인벤토리가 가득 찼습니다. 단서는 분석실 보관대로 옮기거나 이 방의 것이라면 되돌려놓을 수 있습니다."
                class="failure-message" />
            <ui:VisualElement name="inventory-slot-list" class="inventory-slot-list" />
            <ui:Label name="clue-return-failure-message" text="" class="failure-message" />
        </ui:VisualElement>

        <ui:VisualElement name="scent-test-panel" class="panel">
            <ui:Label text="시향" class="panel-title" />
            <ui:Label text="목표 방이 지금 있는 방과 같은 앰플만 시향할 수 있습니다." class="caption" />
            <ui:ScrollView name="scent-test-list" class="scent-test-list" />
            <ui:VisualElement name="scent-test-result" class="scent-test-result" />
        </ui:VisualElement>

        <ui:VisualElement name="memory-map-expanded" class="memory-map-expanded">
            <ui:VisualElement name="memory-map-expanded-panel" class="memory-map-expanded-panel">
                <ui:VisualElement class="memory-map-expanded-header">
                    <ui:Label text="기억 지도" class="panel-title" />
                    <ui:Button name="memory-map-close-button" text="닫기" class="memory-map-close-button" />
                </ui:VisualElement>
                <ui:ScrollView name="memory-map-scroll" class="memory-map-scroll">
                    <ui:VisualElement name="memory-map" class="memory-map-root">
                        <ui:VisualElement name="memory-map-connections" class="memory-map-connections" />
                        <ui:VisualElement name="memory-map-nodes" class="memory-map-nodes" />
                    </ui:VisualElement>
                </ui:ScrollView>
                <ui:Label name="memory-map-selection-info" text="" class="memory-map-selection-info" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
