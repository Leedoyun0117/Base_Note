<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="MemoryRoomScreen.uss" />

    <!-- 기억 방은 2D 씬으로 그려진다. 이 UIDocument가 그 위에 겹치는 것은:
           · 화면 맨 위에 얇게 걸치는 상태 표시줄(HUD)
           · 화면 아래쪽에 상시 뜨는 대화 패널

         picking-mode를 배경 컨테이너마다 Ignore로 꺼 둔다 — 그래야 클릭이
         씬까지 내려가 단서를 집을 수 있다. 대화 패널만 클릭을 받아야 하므로
         그 요소에서만 picking을 다시 켠다. -->
    <ui:VisualElement name="screen" class="hud" picking-mode="Ignore">

        <!-- 신뢰가 깎이면 방이 좌우에서 안쪽으로 닫히는 마스크. UI 레이어라
             카메라 흔들림에 흔들리지 않고 프레임처럼 고정된다. 폭은 코드가
             가시 비율로 정하고, 좁아지는 애니메이션은 USS transition이 한다.
             HUD·대화 패널보다 먼저(뒤에) 그려지도록 맨 앞에 둔다. -->
        <ui:VisualElement name="mask-left" class="mask-panel mask-panel--left" picking-mode="Ignore" />
        <ui:VisualElement name="mask-right" class="mask-panel mask-panel--right" picking-mode="Ignore" />

        <!-- 상단 바. 방 천장 위쪽 여백에만 걸치도록 얇게 유지한다(카메라가
             방 높이에 여백을 더해 잡으므로 그 띠가 항상 비어 있다). -->
        <ui:VisualElement name="hud-bar" class="hud-bar" picking-mode="Ignore">
            <ui:VisualElement class="hud-bar__group" picking-mode="Ignore">
                <ui:Label name="hud-trust" text="" class="hud-bar__stat" />

                <!-- 히로민 게이지. 채워진 만큼이 보유량이고, 세로선(hud-hiromi-marker)이
                     이동 문턱 자리다. 문턱보다 채움이 짧으면(강제 이동 상태)
                     hud-hiromi-fill의 below-threshold 수식 클래스가 붙어 색이 바뀐다. -->
                <ui:VisualElement name="hud-hiromi-group" class="hud-hiromi-group" picking-mode="Ignore">
                    <ui:Label name="hud-hiromi-value" text="" class="hud-bar__stat" />
                    <ui:VisualElement name="hud-hiromi-track" class="hud-hiromi-track" picking-mode="Ignore">
                        <ui:VisualElement name="hud-hiromi-fill" class="hud-hiromi-fill" picking-mode="Ignore" />
                        <ui:VisualElement name="hud-hiromi-marker" class="hud-hiromi-marker" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label name="hud-chance" text="" class="hud-bar__stat" />
                <!-- 손에 든 추출 기억의 색 요약. 개수가 아니라 "이 색을 갖고
                     있나"만 점으로 — 검열의 색 힌트와 대조하는 데 그거면 되고,
                     어느 단서에서 나왔는지는 가방·복원도가 보여 준다. -->
                <ui:VisualElement class="hud-bar__wallet" picking-mode="Ignore">
                    <ui:VisualElement name="hud-held-r" class="hud-held-dot hud-held-dot--r" picking-mode="Ignore" />
                    <ui:VisualElement name="hud-held-g" class="hud-held-dot hud-held-dot--g" picking-mode="Ignore" />
                    <ui:VisualElement name="hud-held-b" class="hud-held-dot hud-held-dot--b" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hud-bar__group" picking-mode="Ignore">
                <ui:Label name="hud-key-hints" text="" class="hud-bar__hint" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 상황 안내. 배경을 칠하지 않아 뒤의 방이 그대로 보인다. -->
        <ui:VisualElement name="hud-messages" class="hud-messages" picking-mode="Ignore">
            <ui:Label name="hud-message" text="" class="failure-message" />
        </ui:VisualElement>

        <!-- 대화 패널. screen을 밀어내지 않고 아래쪽에 겹친다.

             배경·화자·본문 컨테이너는 picking-mode를 Ignore로 꺼 둔다 — 그래야
             패널의 빈 공간을 눌러도 클릭이 뒤의 방까지 내려가 바닥 단서를 집을
             수 있다. 실제로 클릭을 받는 것은 선택지 버튼뿐이다. -->
        <ui:VisualElement name="dialogue-panel" class="dialogue-panel" picking-mode="Ignore">
            <ui:Label name="dialogue-speaker" text="" class="dialogue-panel__speaker" picking-mode="Ignore" />
            <ui:VisualElement name="dialogue-body" class="dialogue-panel__body" picking-mode="Ignore" />
            <ui:VisualElement name="dialogue-choices" class="dialogue-panel__choices" picking-mode="Ignore" />
            <ui:Label name="dialogue-notice" text="" class="dialogue-panel__notice" picking-mode="Ignore" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
