/* 조향실 화면(PerfumeryScreen.uss)과 같은 토큰 값을 그대로 재사용한다 — 새
   색을 추가하지 않는다. UIDocument마다 스타일시트가 독립적이라 값을 다시
   선언해야 하지만, 값 자체는 전부 동일하게 맞춘다. */
:root {
    --bg: #16181B;
    --surface: #1E2126;
    --surface-raised: #282C33;
    --border: #363B44;
    --text: #E4E6EA;
    --text-dim: #8A9099;
    --text-faint: #5A616B;

    --joy: #E5B95C;
    --love: #D98BA0;
    --anger: #C75B4A;
    --sadness: #5B8CB8;
    --fear: #8B7AB8;

    --success: #6FA86B;
    --danger: #C75B4A;

    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-6: 24px;
    --space-8: 32px;

    --radius: 3px;
}

.screen {
    flex-direction: row;
    flex-grow: 1;
    background-color: var(--bg);
}

.panel {
    flex-grow: 1;
    flex-basis: 0;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    margin: var(--space-2);
    padding: var(--space-4);
}

.panel-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--text);
    margin-bottom: var(--space-4);
}

.section-label {
    font-size: 11px;
    color: var(--text-dim);
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
}

.caption {
    font-size: 11px;
    color: var(--text-dim);
    white-space: normal;
}

.failure-message {
    margin-top: var(--space-2);
    font-size: 11px;
    color: var(--danger);
    white-space: normal;
}

/* ── 이동 패널 ─────────────────────────────────────────────── */

.current-room-label {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--text);
}

.restored-badge {
    margin-top: var(--space-1);
    font-size: 11px;
    color: var(--success);
    display: none;
}

.mentality-bar-track {
    height: 12px;
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    overflow: hidden;
}

.mentality-bar-fill {
    height: 100%;
    background-color: var(--success);
}

.neighbor-list {
    flex-grow: 1;
}

.neighbor-row {
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    padding: var(--space-2);
    margin-bottom: var(--space-2);
}

.neighbor-row__name {
    font-size: 14px;
    color: var(--text);
}

.neighbor-row__locked-badge {
    margin-top: var(--space-1);
    font-size: 11px;
    color: var(--danger);
}

.neighbor-row__move-button {
    margin-top: var(--space-2);
    height: 28px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.neighbor-row__move-button:disabled {
    opacity: 0.4;
}

/* ── 단서 패널 ─────────────────────────────────────────────── */

.clue-list {
    flex-grow: 1;
    margin-top: var(--space-2);
}

.clue-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    padding: var(--space-2);
    margin-bottom: var(--space-2);
}

.clue-row__swatches {
    flex-direction: row;
    margin-right: var(--space-2);
}

.clue-row__swatch {
    width: 12px;
    height: 12px;
    border-radius: var(--radius);
    margin-right: var(--space-1);
}

.clue-row__summary {
    font-size: 11px;
    color: var(--text-dim);
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

/* ── 인벤토리 패널 ─────────────────────────────────────────── */

.inventory-slot-list {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: var(--space-2);
}

.inventory-slot {
    width: 88px;
    height: 88px;
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    margin-right: var(--space-2);
    margin-bottom: var(--space-2);
    align-items: center;
    justify-content: center;
    padding: var(--space-1);
}

.inventory-slot--empty {
    background-color: var(--surface);
    opacity: 0.5;
}

.inventory-slot--filled {
    background-color: var(--surface-raised);
}

.inventory-slot__swatch-row {
    flex-direction: row;
}

.inventory-slot__swatch {
    width: 14px;
    height: 14px;
    border-radius: var(--radius);
    margin: 1px;
}

.inventory-slot__category {
    margin-top: var(--space-1);
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--text);
}

.inventory-slot__summary {
    margin-top: var(--space-1);
    font-size: 9px;
    color: var(--text-dim);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ── 시향 패널 ─────────────────────────────────────────────── */

.scent-test-list {
    flex-grow: 1;
    margin-top: var(--space-2);
}

.ampoule-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    padding: var(--space-2);
    margin-bottom: var(--space-2);
}

.ampoule-row__swatch {
    width: 16px;
    height: 16px;
    border-radius: var(--radius);
    margin-right: var(--space-2);
}

.ampoule-row__summary {
    font-size: 11px;
    color: var(--text-dim);
    white-space: normal;
    flex-grow: 1;
    flex-shrink: 1;
}

.ampoule-row__action-button {
    height: 24px;
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.ampoule-row__action-button:disabled {
    opacity: 0.4;
}

.scent-test-ineligible-badge {
    margin-right: var(--space-2);
    font-size: 11px;
    color: var(--text-faint);
}

.scent-test-confirm {
    width: 100%;
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top-width: 1px;
    border-top-color: var(--border);
}

.craft-button {
    margin-top: var(--space-2);
    height: 32px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 12px;
    -unity-font-style: bold;
}

.scent-test-result {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top-width: 1px;
    border-top-color: var(--border);
}

.scent-test-result-text {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text);
}

.scent-test-restored-banner {
    margin-top: var(--space-2);
    padding: var(--space-3);
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--success);
    border-radius: var(--radius);
    color: var(--success);
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
}

.emotion--joy { background-color: var(--joy); }
.emotion--love { background-color: var(--love); }
.emotion--anger { background-color: var(--anger); }
.emotion--sadness { background-color: var(--sadness); }
.emotion--fear { background-color: var(--fear); }
