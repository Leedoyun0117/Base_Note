:root {
    --bg: #16181B;
    --surface: #1E2126;
    --surface-raised: #282C33;
    --border: #363B44;
    --text: #E4E6EA;
    --text-dim: #8A9099;
    --text-faint: #5A616B;

    --success: #6FA86B;
    --danger: #C75B4A;

    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-6: 24px;
    --space-8: 32px;

    --radius: 3px;
}

.failure-message {
    margin-top: var(--space-2);
    font-size: 11px;
    color: var(--danger);
    white-space: normal;
}

/* 화면 전체를 차지하되 아무것도 칠하지 않는다 — 뒤의 2D 방이 그대로
   보여야 한다. 포인터도 받지 않는다(UXML의 picking-mode="Ignore"). */
.hud {
    flex-grow: 1;
}

/* ── 상단 상태 표시줄 ───────────────────────────────────────────
   플레이 공간이 화면의 주인공이므로 HUD는 화면 맨 위에 얇게만 걸친다.
   위쪽을 고른 이유: 카메라가 방 높이에 위아래 여백을 더해 잡기 때문에
   천장 위에 늘 빈 띠가 생긴다. 아래쪽은 바닥 물건 단서가 놓이는 자리라
   같은 두께라도 플레이를 가린다.

   높이를 px로 못박지 않고 내용 높이 + 간격 토큰으로 정한다 — 해상도가
   달라져도 천장 위 여백 안에 머물게 하기 위함이다. */
.hud-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    background-color: rgba(22, 24, 27, 0.72);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.hud-bar__group {
    flex-direction: row;
    align-items: center;
}

/* 조작 가능한 키를 상시 노출한다 — 인벤토리(버리기)는 화면에 버튼이
   없어서, 알려주지 않으면 존재 자체를 알 수 없다. */
.hud-bar__hint {
    font-size: 11px;
    color: var(--text-faint);
}

/* 상단 바 바로 아래. 배경을 칠하지 않아 뒤의 방이 그대로 보인다. */
.hud-messages {
    align-items: center;
    margin-top: var(--space-2);
}
