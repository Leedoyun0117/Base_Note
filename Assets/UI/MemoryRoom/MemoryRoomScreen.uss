/* 조향실 화면(PerfumeryScreen.uss)과 같은 토큰 값을 그대로 재사용한다 — 새
   색을 추가하지 않는다. UIDocument마다 스타일시트가 독립적이라 값을 다시
   선언해야 하지만, 값 자체는 전부 동일하게 맞춘다. */
:root {
    --bg: #16181B;
    --surface: #1E2126;
    --surface-raised: #282C33;
    --border: #363B44;
    --text: #E4E6EA;
    --text-dim: #8A9099;
    --text-faint: #5A616B;

    --joy: #E5B95C;
    --love: #D98BA0;
    --anger: #C75B4A;
    --sadness: #5B8CB8;
    --fear: #8B7AB8;

    --success: #6FA86B;
    --danger: #C75B4A;

    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-6: 24px;
    --space-8: 32px;

    --radius: 3px;
}

.panel-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--text);
    margin-bottom: var(--space-4);
}

.caption {
    font-size: 11px;
    color: var(--text-dim);
    white-space: normal;
}

.failure-message {
    margin-top: var(--space-2);
    font-size: 11px;
    color: var(--danger);
    white-space: normal;
}

/* ── 이동 패널 ─────────────────────────────────────────────── */

.current-room-label {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--text);
}

.restored-badge {
    margin-top: var(--space-1);
    font-size: 11px;
    color: var(--success);
    display: none;
}

.mentality-bar-track {
    height: 12px;
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    overflow: hidden;
}

.mentality-bar-fill {
    height: 100%;
    background-color: var(--success);
}

/* 이동 목록이 없어진 뒤에도 단서 패널의 "줍기" 버튼(ClueCollectionPanelView)이
   같은 스타일을 계속 쓴다 — 이름은 이동 목록 시절 그대로지만, 지금은 이동과
   무관한 버튼 하나만 이 클래스를 쓴다. */

/* ── 기억 지도(재사용 컴포넌트, MemoryMapView) ────────────────
   조향실/분석실 화면(PerfumeryScreen.uss/AnalysisRoomScreen.uss)에도 같은
   값을 그대로 둔다 — 화면마다 스타일시트가 독립적이라 값을 다시 선언해야
   하지만, 값 자체는 동일하게 맞춘다.
   지도는 항상 작은 미리보기(memory-map-preview)로만 패널 안에 보이고,
   누르면 화면 대부분을 덮는 확대 오버레이(memory-map-expanded)가 뜬다. */

.memory-map-expanded {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
}

.memory-map-expanded-panel {
    width: 80%;
    height: 80%;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    padding: var(--space-4);
}

.memory-map-expanded-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
}

.memory-map-close-button {
    height: 28px;
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 12px;
}

.memory-map-scroll {
    flex-grow: 1;
    margin-top: var(--space-2);
}

.memory-map-root {
    position: relative;
}

.memory-map-connections {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.memory-map-nodes {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.memory-map-node {
    position: absolute;
    align-items: center;
    justify-content: center;
    background-color: var(--surface-raised);
    border-width: 2px;
    border-color: var(--border);
}

/* 스프라이트 교체 지점: 기억 방/허브를 지금은 원/사각형 도형과 텍스트
   라벨만으로 구분한다. 나중에 종류별 아이콘 스프라이트로 교체한다. */
.memory-map-node--room {
    border-radius: 100%;
}

.memory-map-node--hub {
    border-radius: var(--radius);
}

.memory-map-node--current {
    border-color: var(--text);
    border-width: 3px;
}

.memory-map-node--restored {
    background-color: var(--success);
}

.memory-map-node--unvisited {
    opacity: 0.35;
}

.memory-map-node--selected {
    border-color: var(--text);
}

/* 기억 진입/이탈 지점(계단) — 눌렀을 때 일반 이동이 아니라 즉시 이탈 지점
   복귀가 일어나므로, 다른 허브 노드와 다르게 눈에 띄어야 한다. */
.memory-map-node--exit {
    background-color: var(--danger);
    border-color: var(--danger);
}

.memory-map-node__label {
    font-size: 9px;
    color: var(--text);
    -unity-text-align: middle-center;
    white-space: normal;
}

.memory-map-selection-info {
    margin-top: var(--space-2);
    font-size: 11px;
    color: var(--text-dim);
    white-space: normal;
}

/* ── 시향 패널 ─────────────────────────────────────────────── */

.scent-test-list {
    flex-grow: 1;
    margin-top: var(--space-2);
}

.ampoule-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    padding: var(--space-2);
    margin-bottom: var(--space-2);
}

.ampoule-row__swatch {
    width: 16px;
    height: 16px;
    border-radius: var(--radius);
    margin-right: var(--space-2);
}

.ampoule-row__summary {
    font-size: 11px;
    color: var(--text-dim);
    white-space: normal;
    flex-grow: 1;
    flex-shrink: 1;
}

.ampoule-row__action-button {
    height: 24px;
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.ampoule-row__action-button:disabled {
    opacity: 0.4;
}

.scent-test-ineligible-badge {
    margin-right: var(--space-2);
    font-size: 11px;
    color: var(--text-faint);
}

.scent-test-confirm {
    width: 100%;
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top-width: 1px;
    border-top-color: var(--border);
}

.craft-button {
    margin-top: var(--space-2);
    height: 32px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 12px;
    -unity-font-style: bold;
}

.scent-test-result {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top-width: 1px;
    border-top-color: var(--border);
}

.scent-test-result-text {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text);
}

.scent-test-restored-banner {
    margin-top: var(--space-2);
    padding: var(--space-3);
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--success);
    border-radius: var(--radius);
    color: var(--success);
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
}

.emotion--joy { background-color: var(--joy); }
.emotion--love { background-color: var(--love); }
.emotion--anger { background-color: var(--anger); }
.emotion--sadness { background-color: var(--sadness); }
.emotion--fear { background-color: var(--fear); }

/* 화면 전체를 차지하되 아무것도 칠하지 않는다 — 뒤의 2D 방이 그대로
   보여야 한다. 포인터도 받지 않는다(UXML의 picking-mode="Ignore"). */
.hud {
    flex-grow: 1;
}

/* ── 상단 상태 표시줄 ───────────────────────────────────────────
   플레이 공간이 화면의 주인공이므로 HUD는 화면 맨 위에 얇게만 걸친다.
   위쪽을 고른 이유: 카메라가 방 높이에 위아래 여백을 더해 잡기 때문에
   천장 위에 늘 빈 띠가 생긴다. 아래쪽은 바닥 물건 단서가 놓이는 자리라
   같은 두께라도 플레이를 가린다.

   높이를 px로 못박지 않고 내용 높이 + 간격 토큰으로 정한다 — 해상도가
   달라져도 천장 위 여백 안에 머물게 하기 위함이다. */
.hud-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    background-color: rgba(22, 24, 27, 0.72);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.hud-bar__group {
    flex-direction: row;
    align-items: center;
}

.hud-bar__label {
    font-size: 11px;
    color: var(--text-dim);
    margin-left: var(--space-2);
    margin-right: var(--space-2);
}

.hud-bar__button {
    height: 24px;
    margin-left: var(--space-2);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 11px;
}

.hud-bar__button:hover {
    border-color: var(--text-dim);
}

/* 조작 가능한 키를 상시 노출한다 — 인벤토리(버리기)와 기록지는 화면에
   버튼이 없어서, 알려주지 않으면 존재 자체를 알 수 없다. */
.hud-bar__hint {
    margin-left: var(--space-4);
    font-size: 11px;
    color: var(--text-faint);
}

/* 상단 바 바로 아래. 배경을 칠하지 않아 뒤의 방이 그대로 보인다. */
.hud-messages {
    align-items: center;
    margin-top: var(--space-2);
}

/* ── 필요할 때만 뜨는 패널 ─────────────────────────────────────
   지도와 시향은 항상 볼 필요가 없다. 뜰 때는 화면을 덮어 포인터를 그대로
   받으므로, 떠 있는 동안 씬 클릭이 자연히 막힌다. */
.modal {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
}

.modal__panel {
    width: 60%;
    max-height: 70%;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    padding: var(--space-4);
}

.modal__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
}

.modal__close-button {
    height: 28px;
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 12px;
}
