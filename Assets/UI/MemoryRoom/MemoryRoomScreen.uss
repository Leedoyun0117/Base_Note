:root {
    --bg: #16181B;
    --surface: #1E2126;
    --surface-raised: #282C33;
    --border: #363B44;
    --text: #E4E6EA;
    --text-dim: #8A9099;
    --text-faint: #5A616B;

    --success: #6FA86B;
    --danger: #C75B4A;

    --memory-red: #C75B4A;
    --memory-green: #6FA86B;
    --memory-blue: #5B8BC7;

    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-6: 24px;
    --space-8: 32px;

    --radius: 3px;

    /* 신뢰가 깎일 때 마스크가 좁아지는 데 걸리는 시간. 이 한 곳에서만 정한다.
       "방금 줄어들었다"가 인지될 만큼 짧게. */
    --mask-shrink-duration: 0.22s;
}

/* ── 신뢰 축소 마스크 ─────────────────────────────────────────────
   좌우에서 안쪽으로 닫히는 판. 폭은 코드가 style.width(%)로 정하고
   (기본 0), 좁아지는 연출은 여기 transition이 맡는다.

   이 판은 이제 아무것도 그리지 않는다 — 덮인 영역의 시각 처리(도트 열화 +
   종이 찢은 경계선)는 전부 URP 풀스크린 셰이더(DotTexture)가 담당한다.
   UI 직선으로는 찢긴 불규칙 윤곽을 만들 수 없기 때문. 이 판이 남아 있는
   이유는 하나뿐: 애니메이션되는 폭을 MemoryRoomBootstrap이 매 프레임 읽어
   셰이더 경계를 같은 속도로 열고 닫는다. */
.mask-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    transition-property: width;
    transition-duration: var(--mask-shrink-duration);
    transition-timing-function: ease-in-out;
}

.mask-panel--left { left: 0; }
.mask-panel--right { right: 0; }

.failure-message {
    margin-top: var(--space-2);
    font-size: 11px;
    color: var(--danger);
    white-space: normal;
}

/* 화면 전체를 차지하되 아무것도 칠하지 않는다 — 뒤의 2D 방이 그대로
   보여야 한다. 포인터도 받지 않는다(UXML의 picking-mode="Ignore"). */
.hud {
    flex-grow: 1;
}

/* ── 상단 상태 표시줄 ───────────────────────────────────────────
   플레이 공간이 화면의 주인공이므로 HUD는 화면 맨 위에 얇게만 걸친다.
   위쪽을 고른 이유: 카메라가 방 높이에 위아래 여백을 더해 잡기 때문에
   천장 위에 늘 빈 띠가 생긴다. 아래쪽은 바닥 물건 단서가 놓이는 자리라
   같은 두께라도 플레이를 가린다.

   높이를 px로 못박지 않고 내용 높이 + 간격 토큰으로 정한다 — 해상도가
   달라져도 천장 위 여백 안에 머물게 하기 위함이다. */
.hud-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    background-color: rgba(22, 24, 27, 0.72);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.hud-bar__group {
    flex-direction: row;
    align-items: center;
}

/* 신뢰 / 남은 추출 자원. 규칙이 아니라 상태 표시라 은은하게. */
.hud-bar__stat {
    font-size: 11px;
    color: var(--text-dim);
    margin-right: var(--space-4);
}

/* 히로민 게이지 — 채워진 만큼이 보유량, 세로선이 이동 문턱. */
.hud-hiromi-group {
    flex-direction: row;
    align-items: center;
    margin-right: var(--space-4);
}

.hud-hiromi-track {
    position: relative;
    width: 64px;
    height: 8px;
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    margin-left: var(--space-1);
}

.hud-hiromi-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0%;
    background-color: var(--success);
}

/* 히로민이 이동 문턱보다 적을 때 — "강제 이동" 상태를 색으로 드러낸다. */
.hud-hiromi-fill--below-threshold {
    background-color: var(--danger);
}

.hud-hiromi-marker {
    position: absolute;
    top: -1px;
    bottom: -1px;
    width: 2px;
    left: 0%;
    background-color: var(--text);
}

/* 색별 기억제 보유 수 — 세 칸을 나란히. */
.hud-bar__wallet {
    flex-direction: row;
    align-items: center;
}

.hud-bar__wallet-item {
    font-size: 11px;
    color: var(--text-faint);
    margin-right: var(--space-2);
}

.hud-bar__wallet-item--r { color: var(--memory-red); }
.hud-bar__wallet-item--g { color: var(--memory-green); }
.hud-bar__wallet-item--b { color: var(--memory-blue); }

/* 조작 가능한 키를 상시 노출한다 — 인벤토리(가방)는 화면에 버튼이
   없어서, 알려주지 않으면 존재 자체를 알 수 없다. */
.hud-bar__hint {
    font-size: 11px;
    color: var(--text-faint);
}

/* 상단 바 바로 아래. 배경을 칠하지 않아 뒤의 방이 그대로 보인다. */
.hud-messages {
    align-items: center;
    margin-top: var(--space-2);
}

/* ── 대화 패널 ─────────────────────────────────────────────────
   화면 아래쪽에 상시. 반투명 배경으로 뒤의 방을 살짝 비친다. 높이는
   내용 기준(포스터·바닥 물건 단서를 가리지 않도록 최대 높이만 제한). */
.dialogue-panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: 40%;
    padding: var(--space-4);
    background-color: rgba(22, 24, 27, 0.88);
    border-top-width: 1px;
    border-top-color: var(--border);
}

.dialogue-panel__speaker {
    font-size: 11px;
    color: var(--text-dim);
    margin-bottom: var(--space-1);
}

/* 검열 조각이 인라인으로 쌓이는 곳. 조각마다 Label 하나. */
.dialogue-panel__body {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    margin-bottom: var(--space-3);
}

.dialogue-segment {
    font-size: 13px;
    color: var(--text);
    white-space: normal;
}

/* 아직 풀리지 않은 마스크 구간 — 무엇을 찾아야 하는지 그 색으로 알린다. */
.dialogue-segment--mask {
    -unity-font-style: bold;
}

.dialogue-segment--mask-r { color: var(--memory-red); }
.dialogue-segment--mask-g { color: var(--memory-green); }
.dialogue-segment--mask-b { color: var(--memory-blue); }

.dialogue-panel__choices {
    flex-direction: column;
    align-items: flex-start;
}

.dialogue-choice {
    font-size: 12px;
    color: var(--text);
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    padding: var(--space-2);
    margin-bottom: var(--space-2);
}

/* ClueSelection 줄: "가진 단서로 답하세요" 안내 + 단서 버튼들. */
.dialogue-clue-prompt {
    font-size: 11px;
    color: var(--text-dim);
    margin-bottom: var(--space-2);
    white-space: normal;
}

.dialogue-choice--clue-answer {
    background-color: var(--surface);
    border-color: var(--text-faint);
}

/* "잘 기억나지 않는다" — 단서로 답하지 않고 넘어가는 길. */
.dialogue-choice--skip {
    color: var(--text-dim);
    -unity-font-style: italic;
}

.dialogue-panel__notice {
    font-size: 11px;
    color: var(--text-faint);
    margin-top: var(--space-2);
    white-space: normal;
}

/* ── 마스크 해금 확인 팝업 ─────────────────────────────────────── */
.dialogue-unlock-prompt {
    display: none;
    margin-top: var(--space-3);
    padding: var(--space-3);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
}

.dialogue-unlock-prompt__text {
    font-size: 12px;
    color: var(--text);
    white-space: normal;
    margin-bottom: var(--space-2);
}

.dialogue-unlock-prompt__actions {
    flex-direction: row;
    align-items: center;
}

.dialogue-unlock-prompt__confirm,
.dialogue-unlock-prompt__cancel {
    font-size: 12px;
    padding: var(--space-1);
    margin-right: var(--space-2);
}
