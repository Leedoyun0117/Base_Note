:root {
    --bg: #16181B;
    --surface: #1E2126;
    --surface-raised: #282C33;
    --border: #363B44;
    --text: #E4E6EA;
    --text-dim: #8A9099;
    --text-faint: #5A616B;

    --success: #6FA86B;
    --danger: #C75B4A;

    --memory-red: #C75B4A;
    --memory-green: #6FA86B;
    --memory-blue: #5B8BC7;

    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-6: 24px;
    --space-8: 32px;

    --radius: 3px;

    /* 신뢰가 깎일 때 마스크가 좁아지는 데 걸리는 시간. 이 한 곳에서만 정한다.
       "방금 줄어들었다"가 인지될 만큼 짧게. */
    --mask-shrink-duration: 0.22s;
}

/* ── 신뢰 축소 마스크 ─────────────────────────────────────────────
   좌우에서 안쪽으로 닫히는 판. 폭은 코드가 style.width(%)로 정하고
   (기본 0), 좁아지는 연출은 여기 transition이 맡는다.

   이 판은 이제 아무것도 그리지 않는다 — 덮인 영역의 시각 처리(도트 열화 +
   종이 찢은 경계선)는 전부 URP 풀스크린 셰이더(DotTexture)가 담당한다.
   UI 직선으로는 찢긴 불규칙 윤곽을 만들 수 없기 때문. 이 판이 남아 있는
   이유는 하나뿐: 애니메이션되는 폭을 MemoryRoomBootstrap이 매 프레임 읽어
   셰이더 경계를 같은 속도로 열고 닫는다. */
.mask-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    transition-property: width;
    transition-duration: var(--mask-shrink-duration);
    transition-timing-function: ease-in-out;
}

.mask-panel--left { left: 0; }
.mask-panel--right { right: 0; }

.failure-message {
    margin-top: var(--space-2);
    font-size: 11px;
    color: var(--danger);
    white-space: normal;
}

/* 화면 전체를 차지하되 아무것도 칠하지 않는다 — 뒤의 2D 방이 그대로
   보여야 한다. 포인터도 받지 않는다(UXML의 picking-mode="Ignore"). */
.hud {
    flex-grow: 1;
}

/* ── 상단 상태 표시줄 ───────────────────────────────────────────
   플레이 공간이 화면의 주인공이므로 HUD는 화면 맨 위에 얇게만 걸친다.
   위쪽을 고른 이유: 카메라가 방 높이에 위아래 여백을 더해 잡기 때문에
   천장 위에 늘 빈 띠가 생긴다. 아래쪽은 바닥 물건 단서가 놓이는 자리라
   같은 두께라도 플레이를 가린다.

   높이를 px로 못박지 않고 내용 높이 + 간격 토큰으로 정한다 — 해상도가
   달라져도 천장 위 여백 안에 머물게 하기 위함이다. */
.hud-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    background-color: rgba(22, 24, 27, 0.72);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.hud-bar__group {
    flex-direction: row;
    align-items: center;
}

/* 신뢰 / 남은 추출 자원. 규칙이 아니라 상태 표시라 은은하게. */
.hud-bar__stat {
    font-size: 11px;
    color: var(--text-dim);
    margin-right: var(--space-4);
}

/* 안정 축 게이지 — 중앙 기준선에서 좌우로 벌어지는 양방향 바. */
.hud-stability-group {
    flex-direction: row;
    align-items: center;
    margin-right: var(--space-4);
}

/* 폭을 넉넉히 잡는다 — 중앙에서 얼마나 벌어졌는지가 한눈에 읽혀야 한다.
   모서리는 각지게(계기처럼), 기준선이 위아래로 삐져나오도록 overflow도 연다. */
.hud-stability-track {
    position: relative;
    width: 160px;
    height: 14px;
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 0;
    overflow: visible;
    flex-shrink: 0;
    margin-left: var(--space-1);
}

/* 채움. left/width는 코드가 축 위치·범위에 맞춰 정한다(음수면 기준선 왼쪽,
   양수면 오른쪽). 기본값은 0(안정)일 때의 자리 = 폭 0. */
.hud-stability-fill {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: var(--memory-blue);
}

/* 0(안정) 자리의 얇은 세로 기준선. left는 코드가 정한다(비대칭 범위 대비).
   트랙 위아래로 5px씩 삐져나와 "눈금"이 아니라 "기준"으로 읽힌다. */
.hud-stability-baseline {
    position: absolute;
    top: -5px;
    bottom: -5px;
    width: 2px;
    left: 50%;
    margin-left: -1px;
    background-color: #FFFFFF;
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.65);
    border-right-color: rgba(0, 0, 0, 0.65);
}

/* 손에 든 추출 기억의 색 요약 — 세 점을 나란히. 개수가 아니라 보유 여부만:
   검열 해금은 태그로 판정하고 색은 힌트일 뿐이라, "이 색이 있나"만 알면
   가방을 열지 판단할 수 있다. 상세는 가방·복원도가 맡는다. */
.hud-bar__wallet {
    flex-direction: row;
    align-items: center;
}

/* 미보유 상태 = 빈 테두리 점. 자리를 지켜 "이 색은 지금 없다"를 드러낸다. */
.hud-held-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: var(--space-1);
    background-color: transparent;
    border-width: 1px;
    border-color: var(--text-faint);
}

/* 보유 시에만 그 색으로 꽉 찬다. */
.hud-held-dot--r.hud-held-dot--held { background-color: var(--memory-red); border-color: var(--memory-red); }
.hud-held-dot--g.hud-held-dot--held { background-color: var(--memory-green); border-color: var(--memory-green); }
.hud-held-dot--b.hud-held-dot--held { background-color: var(--memory-blue); border-color: var(--memory-blue); }

/* 조작 가능한 키를 상시 노출한다 — 인벤토리(가방)는 화면에 버튼이
   없어서, 알려주지 않으면 존재 자체를 알 수 없다. */
.hud-bar__hint {
    font-size: 11px;
    color: var(--text-faint);
}

/* 상단 바 바로 아래. 배경을 칠하지 않아 뒤의 방이 그대로 보인다. */
.hud-messages {
    align-items: center;
    margin-top: var(--space-2);
}

/* ── 대화 패널 ─────────────────────────────────────────────────
   화면 아래쪽에 상시. 반투명 배경으로 뒤의 방을 살짝 비친다. 높이는
   내용 기준(포스터·바닥 물건 단서를 가리지 않도록 최대 높이만 제한). */
.dialogue-panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: 40%;
    padding: var(--space-4);
    background-color: rgba(22, 24, 27, 0.88);
    border-top-width: 1px;
    border-top-color: var(--border);
}

.dialogue-panel__speaker {
    font-size: 11px;
    color: var(--text-dim);
    margin-bottom: var(--space-1);
}

/* 검열 조각이 인라인으로 쌓이는 곳. 조각마다 Label 하나. */
.dialogue-panel__body {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    margin-bottom: var(--space-3);
}

.dialogue-segment {
    font-size: 13px;
    color: var(--text);
    white-space: normal;
}

.dialogue-panel__choices {
    flex-direction: column;
    align-items: flex-start;
}

.dialogue-choice {
    font-size: 12px;
    color: var(--text);
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    padding: var(--space-2);
    margin-bottom: var(--space-2);
}

/* ClueSelection 줄: "가진 단서로 답하세요" 안내 + 단서 행들. */
.dialogue-clue-prompt {
    font-size: 11px;
    color: var(--text-dim);
    margin-bottom: var(--space-2);
    white-space: normal;
}

/* 단서 하나 = [답하기] + [기억 추출] 한 줄. */
.dialogue-clue-row {
    flex-direction: row;
    align-items: center;
}

.dialogue-choice--clue-answer {
    background-color: var(--surface);
    border-color: var(--text-faint);
}

/* 그 자리에서 기억을 추출하는 버튼 — 히로민을 쓴다. */
.dialogue-choice--extract {
    font-size: 11px;
    color: var(--text-dim);
    margin-left: var(--space-2);
}

/* "잘 기억나지 않는다" — 단서로 답하지 않고 넘어가는 길. */
.dialogue-choice--skip {
    color: var(--text-dim);
    -unity-font-style: italic;
}

.dialogue-panel__notice {
    font-size: 11px;
    color: var(--text-faint);
    margin-top: var(--space-2);
    white-space: normal;
}
