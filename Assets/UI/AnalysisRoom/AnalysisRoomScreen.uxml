<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="AnalysisRoomScreen.uss" />

    <ui:VisualElement name="screen" class="screen">

        <ui:VisualElement name="navigation-panel" class="panel">
            <ui:Label text="분석실" class="panel-title" />

            <ui:Label name="current-room-label" text="-" class="current-room-label" />
            <ui:Label name="current-room-restored-badge" text="복원됨" class="restored-badge" />

            <ui:Label text="정신력" class="section-label" />
            <ui:VisualElement class="mentality-bar-track">
                <ui:VisualElement name="mentality-bar-fill" class="mentality-bar-fill" />
            </ui:VisualElement>
            <ui:Label name="mentality-value" text="- / -" class="caption" />
            <ui:Label name="mentality-affordance-notice" text="" class="caption" />
            <ui:Label name="mentality-notice" text="" class="failure-message" />
            <ui:Label name="move-failure-message" text="" class="failure-message" />

            <ui:Label text="기억 지도" class="section-label" />
            <ui:Label text="누르면 크게 볼 수 있습니다." class="caption" />
            <ui:VisualElement name="memory-map-preview" class="memory-map-preview" />
        </ui:VisualElement>

        <ui:VisualElement name="analysis-panel" class="panel panel--wide">
            <ui:Label text="단서 분석" class="panel-title" />
            <ui:Label text="인벤토리 또는 보관대의 단서를 분석할 수 있습니다. 앰플은 여기 표시되지 않습니다." class="caption" />

            <ui:ScrollView name="clue-analysis-list" class="clue-analysis-list" />
            <ui:Label name="analysis-failure-message" text="" class="failure-message" />
            <ui:VisualElement name="analysis-result" class="analysis-result" />
        </ui:VisualElement>

        <ui:VisualElement name="clue-storage-panel" class="panel">
            <ui:Label text="단서 보관대" class="panel-title" />
            <ui:Label text="분석을 마친 단서를 여기 놓아두면 인벤토리 자리가 비고, 나중에 다시 꺼내 더 분석할 수 있습니다." class="caption" />

            <ui:Label text="보관대" class="section-label" />
            <ui:Label name="clue-storage-count" text="- / -" class="caption" />
            <ui:ScrollView name="clue-storage-list" class="clue-analysis-list" />

            <ui:Label text="인벤토리" class="section-label" />
            <ui:Label name="clue-storage-inventory-count" text="- / -" class="caption" />
            <ui:Label
                name="clue-storage-inventory-full-notice"
                text="인벤토리가 가득 찼습니다. 분석을 마친 단서를 보관대로 옮기세요."
                class="failure-message" />
            <ui:ScrollView name="clue-storage-inventory-list" class="clue-analysis-list" />

            <ui:Label name="clue-storage-transfer-failure-message" text="" class="failure-message" />
        </ui:VisualElement>

        <ui:VisualElement name="memory-map-expanded" class="memory-map-expanded">
            <ui:VisualElement name="memory-map-expanded-panel" class="memory-map-expanded-panel">
                <ui:VisualElement class="memory-map-expanded-header">
                    <ui:Label text="기억 지도" class="panel-title" />
                    <ui:Button name="memory-map-close-button" text="닫기" class="memory-map-close-button" />
                </ui:VisualElement>
                <ui:ScrollView name="memory-map-scroll" class="memory-map-scroll">
                    <ui:VisualElement name="memory-map" class="memory-map-root">
                        <ui:VisualElement name="memory-map-connections" class="memory-map-connections" />
                        <ui:VisualElement name="memory-map-nodes" class="memory-map-nodes" />
                    </ui:VisualElement>
                </ui:ScrollView>
                <ui:Label name="memory-map-selection-info" text="" class="memory-map-selection-info" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
