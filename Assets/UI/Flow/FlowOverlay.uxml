<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="FlowOverlay.uss" />

    <ui:VisualElement name="flow-overlay" class="flow-overlay">

        <ui:VisualElement name="dialogue-panel" class="dialogue-panel">
            <ui:Label name="dialogue-speaker" text="-" class="dialogue-speaker" />
            <ui:Label name="dialogue-text" text="-" class="dialogue-text" />
            <ui:Label text="스페이스 또는 아래 버튼으로 계속" class="caption" />
            <ui:Button name="dialogue-advance-button" text="다음" class="craft-button" />
        </ui:VisualElement>

        <ui:VisualElement name="exit-confirm-panel" class="exit-confirm-panel">
            <ui:Label text="계단 앞에 서 있습니다." class="panel-title" />
            <ui:Label name="exit-mentality-notice" text="" class="failure-message" />
            <ui:Button name="request-exit-button" text="현실로 복귀" class="craft-button" />

            <ui:VisualElement name="exit-confirm-controls" class="exit-confirm-controls">
                <ui:Label text="현실로 돌아가면 이 기억으로 다시 들어올 수 없습니다." class="failure-message" />
                <ui:Button name="confirm-exit-button" text="복귀 확정" class="craft-button" />
                <ui:Button name="cancel-exit-button" text="취소" class="ampoule-row__action-button" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
