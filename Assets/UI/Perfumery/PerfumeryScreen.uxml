<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="PerfumeryScreen.uss" />

    <ui:VisualElement name="screen" class="screen">

        <ui:VisualElement name="room-panel" class="panel">
            <ui:Label text="기억 방" class="panel-title" />

            <ui:Label name="current-room-label" text="-" class="current-room-label" />
            <ui:Label name="current-room-restored-badge" text="복원됨" class="restored-badge" />
            <ui:VisualElement class="mentality-bar-track">
                <ui:VisualElement name="mentality-bar-fill" class="mentality-bar-fill" />
            </ui:VisualElement>
            <ui:Label name="mentality-value" text="- / -" class="caption" />
            <ui:Label name="mentality-affordance-notice" text="" class="caption" />
            <ui:Label name="mentality-notice" text="" class="failure-message" />
            <ui:Label name="move-failure-message" text="" class="failure-message" />

            <ui:Label text="기억 지도 — 이동" class="section-label" />
            <ui:Label text="누르면 크게 볼 수 있습니다." class="caption" />
            <ui:VisualElement name="memory-map-preview" class="memory-map-preview" />

            <ui:Label text="제작 대상 방" class="section-label" />
            <ui:ScrollView name="room-list" class="room-list" />
            <ui:VisualElement class="required-total-block">
                <ui:Label text="요구 총량" class="caption" />
                <ui:Label name="required-total-value" text="-" class="required-total-value" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="perfumery-panel" class="panel">
            <ui:Label text="조향" class="panel-title" />

            <ui:Label text="바탕 감정" class="section-label" />
            <ui:VisualElement name="base-emotion-slots" class="base-emotion-row" />

            <ui:Label text="보조 감정" class="section-label" />
            <ui:VisualElement name="supporting-emotion-rows" class="supporting-emotion-list" />

            <ui:VisualElement class="total-block">
                <ui:Label name="total-over-required" text="0 / -" class="total-value" />
            </ui:VisualElement>

            <ui:Label text="위반 사항" class="section-label" />
            <ui:VisualElement name="violations-list" class="violations-list" />

            <ui:Button name="add-to-queue-button" text="대기열에 담기" class="craft-button" />

            <ui:Label text="제작 대기열" class="section-label" />
            <ui:VisualElement name="craft-queue-list" class="craft-queue-list" />
            <ui:Label name="craft-cost-notice" text="" class="caption" />

            <ui:Button name="craft-queue-button" text="대기열 일괄 제작" class="craft-button" />
            <ui:Label name="craft-result-message" text="" class="failure-message" />
        </ui:VisualElement>

        <ui:VisualElement name="status-panel" class="panel">
            <ui:Label text="상태" class="panel-title" />

            <ui:Label text="정신력" class="section-label" />
            <ui:VisualElement class="mentality-bar-track">
                <ui:VisualElement name="mentality-bar-fill" class="mentality-bar-fill" />
            </ui:VisualElement>
            <ui:Label name="mentality-value" text="- / -" class="caption" />

            <ui:Label text="조향실 보관함" class="section-label" />
            <ui:Label name="storage-count" text="- / -" class="caption" />
            <ui:ScrollView name="storage-list" class="ampoule-list" />

            <ui:Label text="인벤토리" class="section-label" />
            <ui:Label name="inventory-count" text="- / -" class="caption" />
            <ui:ScrollView name="inventory-list" class="ampoule-list" />

            <ui:Label name="transfer-failure-message" text="" class="failure-message" />
        </ui:VisualElement>

        <ui:VisualElement name="memory-map-expanded" class="memory-map-expanded">
            <ui:VisualElement name="memory-map-expanded-panel" class="memory-map-expanded-panel">
                <ui:VisualElement class="memory-map-expanded-header">
                    <ui:Label text="기억 지도" class="panel-title" />
                    <ui:Button name="memory-map-close-button" text="닫기" class="memory-map-close-button" />
                </ui:VisualElement>
                <ui:ScrollView name="memory-map-scroll" class="memory-map-scroll">
                    <ui:VisualElement name="memory-map" class="memory-map-root">
                        <ui:VisualElement name="memory-map-connections" class="memory-map-connections" />
                        <ui:VisualElement name="memory-map-nodes" class="memory-map-nodes" />
                    </ui:VisualElement>
                </ui:ScrollView>
                <ui:Label name="memory-map-selection-info" text="" class="memory-map-selection-info" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
