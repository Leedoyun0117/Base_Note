/* 조향실 화면(PerfumeryScreen.uss)과 동일한 디자인 토큰을 그대로 재사용한다 —
   새 색이나 치수를 만들지 않는다. */

:root {
    --bg: #16181B;
    --surface: #1E2126;
    --surface-raised: #282C33;
    --border: #363B44;
    --text: #E4E6EA;
    --text-dim: #8A9099;
    --text-faint: #5A616B;

    --success: #6FA86B;
    --danger: #C75B4A;

    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-6: 24px;
    --space-8: 32px;

    --radius: 3px;
}

.screen {
    flex-direction: row;
    flex-grow: 1;
    background-color: var(--bg);
}

.panel {
    flex-grow: 1;
    flex-basis: 0;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    margin: var(--space-2);
    padding: var(--space-4);
}

.panel-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--text);
    margin-bottom: var(--space-4);
}

.section-label {
    font-size: 11px;
    color: var(--text-dim);
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
}

.caption {
    font-size: 11px;
    color: var(--text-dim);
}

.headline-value {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--text);
}

.room-results-list {
    flex-grow: 1;
}

.room-result-row {
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    padding: var(--space-2);
    margin-bottom: var(--space-2);
}

.room-result-row__name {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text);
}

.room-result-row__detail {
    font-size: 11px;
    color: var(--text-dim);
    margin-top: var(--space-1);
}

.upgrade-list {
    flex-grow: 1;
}

.upgrade-row {
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    padding: var(--space-2);
    margin-bottom: var(--space-2);
}

.upgrade-row__name {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text);
}

.upgrade-row__description {
    font-size: 11px;
    color: var(--text-dim);
    margin-top: var(--space-1);
}

.upgrade-row__buy-button {
    margin-top: var(--space-2);
    height: 28px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.upgrade-row__buy-button:disabled {
    opacity: 0.4;
}

.craft-button {
    margin-top: var(--space-4);
    height: 40px;
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 14px;
    -unity-font-style: bold;
}

.craft-button:disabled {
    opacity: 0.4;
}

.failure-message {
    margin-top: var(--space-2);
    font-size: 11px;
    color: var(--danger);
    white-space: normal;
}
