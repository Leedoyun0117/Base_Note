/* 조향실 화면(PerfumeryScreen.uss)의 :root 토큰만 그대로 재사용한다 —
   새 색을 추가하지 않는다. UIDocument마다 스타일시트가 독립적이므로 토큰을
   다시 선언해야 하지만, 값은 전부 동일하게 맞춘다. */
:root {
    --bg: #16181B;
    --surface: #1E2126;
    --surface-raised: #282C33;
    --border: #363B44;
    --text: #E4E6EA;
    --text-dim: #8A9099;
    --text-faint: #5A616B;

    --joy: #E5B95C;
    --love: #D98BA0;
    --anger: #C75B4A;
    --sadness: #5B8CB8;
    --fear: #8B7AB8;

    --success: #6FA86B;
    --danger: #C75B4A;

    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-6: 24px;
    --space-8: 32px;

    --radius: 3px;
}

.journal-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--bg);
    justify-content: center;
    align-items: center;
}

.journal-panel {
    width: 70%;
    height: 80%;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    padding: var(--space-4);
}

.panel-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--text);
    margin-bottom: var(--space-2);
}

.commission-label {
    font-size: 14px;
    color: var(--text-dim);
    margin-bottom: var(--space-4);
}

.journal-tabs {
    flex-direction: row;
    margin-bottom: var(--space-4);
}

.journal-tab {
    height: 32px;
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    margin-right: var(--space-2);
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    color: var(--text-dim);
    font-size: 14px;
}

.journal-tab--selected {
    color: var(--text);
    border-color: var(--text);
}

.journal-content {
    flex-grow: 1;
}

.journal-empty {
    font-size: 14px;
    color: var(--text-faint);
}

.journal-entry {
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
}

.journal-entry__speaker {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text);
}

.journal-entry__text {
    font-size: 14px;
    color: var(--text);
    white-space: normal;
    margin-top: var(--space-1);
}

.journal-entry__title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text);
}

.journal-entry__state {
    font-size: 11px;
    color: var(--text-dim);
    margin-top: var(--space-1);
}

.journal-entry__test-result {
    font-size: 11px;
    color: var(--text);
    margin-top: var(--space-1);
}

.journal-emotion-chip-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: var(--space-2);
}

.emotion-chip {
    flex-direction: row;
    align-items: center;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius);
    padding: var(--space-1) var(--space-2);
    margin-right: var(--space-2);
    margin-bottom: var(--space-1);
}

.emotion-chip__swatch {
    width: 10px;
    height: 10px;
    border-radius: var(--radius);
    margin-right: var(--space-1);
}

.emotion-chip__value {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--text);
}

.emotion-chip__value--hidden {
    font-size: 11px;
    color: var(--text-faint);
}

.emotion--joy { background-color: var(--joy); }
.emotion--love { background-color: var(--love); }
.emotion--anger { background-color: var(--anger); }
.emotion--sadness { background-color: var(--sadness); }
.emotion--fear { background-color: var(--fear); }
