<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="JournalScreen.uss" />

    <ui:VisualElement name="journal-overlay" class="journal-overlay">
        <ui:VisualElement name="journal-panel" class="journal-panel">
            <ui:Label text="기록지" class="panel-title" />
            <ui:Label name="commission-label" text="-" class="commission-label" />

            <ui:VisualElement class="journal-tabs">
                <ui:Button name="tab-dialogue" text="대화" class="journal-tab" />
                <ui:Button name="tab-analysis" text="분석" class="journal-tab" />
                <ui:Button name="tab-ampoules" text="앰플 · 시향" class="journal-tab" />
            </ui:VisualElement>

            <ui:ScrollView name="journal-content" class="journal-content" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
