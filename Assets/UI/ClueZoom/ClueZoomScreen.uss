/* 단서 설명 창. 화면 가운데에 카드 하나를 띄운다. 확대 화면이 아니라 작은
   모달이므로 뒤의 방을 까맣게 덮지 않고 살짝만 어둡게 해, 바깥을 눌러 닫을
   수 있다는 것만 알린다. [수집]으로 습득, [그만두기]나 바깥 클릭으로 닫는다. */

.clue-zoom-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 10, 14, 0.45);
}

.clue-zoom-stage {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.clue-zoom-card {
    min-width: 320px;
    min-height: 220px;
    padding: 24px;
    align-items: center;
    justify-content: center;
    background-color: rgb(48, 44, 58);
    border-width: 2px;
    border-color: rgb(120, 112, 140);
    border-radius: 10px;
}

.clue-zoom-card__name {
    color: rgb(236, 232, 244);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    white-space: normal;
}

.clue-zoom-card__kind {
    color: rgb(150, 144, 166);
    font-size: 12px;
    margin-bottom: 12px;
    white-space: normal;
}

.clue-zoom-message {
    color: rgb(240, 150, 150);
    font-size: 13px;
    margin-bottom: 12px;
    white-space: normal;
}

.clue-zoom-card__actions {
    flex-direction: row;
    align-items: center;
}

.clue-zoom-collect-button,
.clue-zoom-exit-button {
    height: 40px;
    padding-left: 18px;
    padding-right: 18px;
    margin-left: 6px;
    margin-right: 6px;
    border-width: 0;
    border-radius: 6px;
    font-size: 15px;
}

.clue-zoom-collect-button {
    background-color: rgb(70, 120, 90);
    color: rgb(240, 250, 244);
}

.clue-zoom-collect-button:hover {
    background-color: rgb(86, 142, 108);
}

.clue-zoom-exit-button {
    background-color: rgb(64, 60, 76);
    color: rgb(220, 214, 232);
}

.clue-zoom-exit-button:hover {
    background-color: rgb(80, 76, 94);
}
